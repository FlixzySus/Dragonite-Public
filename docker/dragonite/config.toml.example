# Dragonite config for the Docker Compose stack in ../docker-compose.yml
#
# Differences from ../../dragonite/config.toml.example:
#   - api_host is 0.0.0.0 so the admin container can reach the API
#   - mariadb / rotom / golbat / koji are the compose service names, all on the internal network
#
# setup.ps1 copies this file to config.toml and replaces every double-underscore placeholder (e.g. __DB_PASSWORD__) with the matching
# value from .env. If you copy it by hand, fill those in yourself.

[general]
# Host and Port used for the Dragonite API (must be 0.0.0.0 inside Docker)
api_host = "0.0.0.0"
api_port = 7272

# Whether raw worker stats are written
stats = true

[auth.ptc]
# to use this provider pls enable it
enable = false
# seconds to sleep in-between PTC authing on one proxy
#login_delay = 20
# Uses login proxy as you wish, e.g. Swirlix or Xilriws
#remote_auth_url = "http://host.docker.internal:1234/api/v1/login-code"
# background initer to collect tokens of accounts without using them - this is false by default
#token_init_enabled=true
# don't rely on remote auth and only use accounts with stored token
#token_refresh_only = true

[auth.nk]
# to use this provider pls enable it
enable = false
# seconds to sleep in-between NK authing on one proxy
#login_delay = 20
# background initer to collect tokens of accounts without using them - this is false by default
#token_init_enabled=true
# don't rely on user-pass auth and only use accounts with stored token
#token_refresh_only = true

[koji]
url = "http://koji:8080"
bearer_token = "__KOJI_SECRET__"

#[prometheus]
#enabled = true

[tuning]
#recycle_gmo_limit = 4990
#recycle_encounter_limit = 9975
#recycle_invasion_limit = 900
#minimum_account_reuse_hours = 169 # Default is 0
#scout_age_limit = 30 # Default is 30 minutes.
#location_delay = 2500 # Default is 2500 milliseconds.
#fort_location_delay = 0

#[accounts]
#required_level = 30 # used for everything except leveling (quest can force level 31 at specific events)
#leveling_level = 31 # used to stop leveling at certain level

[rotom]
endpoint = "ws://rotom:7071"
# must match controllerListener.secret in ../rotom/config/local.json (empty by default)
#secret = ""

[processors]
# Golbat Endpoint is singular - and will configure an endpoint for raw sending and API
golbat_endpoint = "http://golbat:9001"
golbat_raw_bearer = "__GOLBAT_RAW_BEARER__"
golbat_api_secret = "__GOLBAT_API_SECRET__"
# if this is present then dragonite will not send raws to the httpendpoint - not used for API, be careful if you use grpc you still need 'golbat_endpoint' for API calls to Golbat
#golbat_grpc_endpoint = "golbat:50001"

[logging]
save = true
#debug = false
#max_size = 500 # MB
#max_age = 30 # days

[db.dragonite]
host = "mariadb"
port = 3306
user = "__DB_USER__"
password = "__DB_PASSWORD__"
name = "__DB_NAME__"
pool_size = 1
