# Copy to .env and fill in. setup.ps1 does this automatically and generates every "change-me".
# Never commit the real .env (it is gitignored).

# --- MariaDB (one server, three databases, one user with access to all three) ---
DB_ROOT_PASSWORD=change-me
DB_USER=dragonite
DB_PASSWORD=change-me
DB_NAME=dragonite
GOLBAT_DB_NAME=golbat
KOJI_DB_NAME=koji
# InnoDB buffer pool. 1G is fine for a small setup; raise on a machine with lots of RAM.
DB_BUFFER_POOL=1G

# --- Ports published on the host ---
DRAGONITE_PORT=7272
ADMIN_PORT=7273
GOLBAT_PORT=9001
KOJI_PORT=8080
ROTOM_DEVICE_PORT=7070
ROTOM_CONTROLLER_PORT=7071
ROTOM_UI_PORT=7072

# --- Dragonite Admin web UI ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Header secret for the admin API (X-Dragonite-Admin-Secret). Leave empty to disable.
ADMIN_API_SECRET=
# Signs login tokens.
ADMIN_JWT_SECRET=change-me

# --- Golbat ---
# Secret required on Golbat API calls (used by Dragonite, Admin, maps, ...)
GOLBAT_API_SECRET=change-me
# Bearer Dragonite must send with raw data
GOLBAT_RAW_BEARER=change-me

# --- Koji ---
# Bearer token for the Koji API and password for the Koji web UI
KOJI_SECRET=change-me
# Name of the Koji project whose geofences Golbat loads (create it in the Koji UI)
KOJI_GOLBAT_PROJECT=golbat
# Where the Koji map opens by default
KOJI_START_LAT=0
KOJI_START_LON=0
