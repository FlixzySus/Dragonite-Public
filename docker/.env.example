# Copy to .env and fill in. setup.ps1 does this automatically and generates random secrets.
# Never commit the real .env (it is gitignored).

# --- MariaDB ---
DB_ROOT_PASSWORD=change-me
DB_NAME=dragonite
DB_USER=dragonite
DB_PASSWORD=change-me

# --- Ports published on the host ---
DRAGONITE_PORT=7272
ADMIN_PORT=7273

# --- Admin web UI ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Header secret for the admin API (X-Dragonite-Admin-Secret). Leave empty to disable.
ADMIN_API_SECRET=
# Signs login tokens. Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=change-me

# --- Golbat (needed by the admin UI; fill in once Golbat is running) ---
# host.docker.internal = a process running directly on your Windows host.
# If Golbat runs in another compose project on the same Docker network, use its service name instead.
GOLBAT_ENDPOINT=http://host.docker.internal:9001
GOLBAT_API_SECRET=
